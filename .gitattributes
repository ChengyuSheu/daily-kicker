# Store text as LF in the repo, check out native on each platform.
# Keeps Windows checkouts from showing whole-file diffs on every edit.
* text=auto

*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.md     text eol=lf

# Binary assets — never munge.
*.png    binary
*.jpg    binary
*.gif    binary
*.svg    text eol=lf
*.wav    binary
*.mp3    binary
*.ogg    binary
*.ttf    binary
*.woff   binary
*.woff2  binary
